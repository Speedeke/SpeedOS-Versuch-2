# .gitignore — was NICHT ins Git-Repository gehört

# Build-Artefakte von cargo (kompilierte Dateien, Boot-Images) —
# lassen sich jederzeit mit `cargo build` neu erzeugen.
/target
# ... auch die des boot/-Runners (eigenständiger Workspace):
/boot/target
# ... und die der User-Programme (eigener Workspace, eigener Baum — er MUSS
# getrennt bleiben, sonst wartet der innere cargo-Aufruf aus build.rs auf
# die Dateisperre des äußeren):
/userland/target

# Persistente Daten-Platten-Images (Nutzerdaten der VM — kein Build-Artefakt,
# aber auch nichts fuers Repository; werden vom Runner bei Bedarf neu angelegt):
speedos-daten.img
speedos-daten-test.img

# Devlog-Screenshots (lokal, nicht im Repository). MIT / AM ANFANG, damit
# nur der Ordner im Projekt-Wurzelverzeichnis gemeint ist — ohne den Schrägstrich
# hätte die Regel auch docs/screenshots/ verschluckt, und genau die Bilder
# gehören ins Repository (die README zeigt sie):
/screenshots/
speedos-fat.img

# Das USB-Live-Image (Build-Artefakt von `cargo image`, jederzeit neu
# baubar — gehoert nicht ins Repository):
speedos-live.img
# Die beschreibbare NVRAM-Kopie, die tools/live_qemu.ps1 pro QEMU-Lauf anlegt:
speedos-live.vars.fd

# Das selbst ausgestellte Testzertifikat von tools/tls_testserver.py.
# Ein privater Schluessel gehoert nicht ins Repository — auch kein wertloser,
# denn sonst gewoehnt man sich daran. Das Skript erzeugt ihn beim ersten Start.
/tools/testcert/

# Pythons Bytecode-Cache der Werkzeuge in tools/.
/tools/__pycache__/

# Der Netz-Mitschnitt von SPEEDOS_NET_DUMP=1 (Debug-Artefakt, jederzeit neu
# erzeugbar — und mit ~1 MiB je Lauf nichts fuers Repository).
speedos-net.pcap
